#!/usr/bin/env bash
# Starts WireCat as on a computer that has never seen it: the sandbox named "fresh" (empty home, no Node.js on PATH,
# no keyring). Your own tools, settings, data and sign-ins are not read and not changed.
#
#   bin/try-fresh-install           start (the same sandbox home as last time)
#   bin/try-fresh-install --reset   start from an empty home again
#
# The same as bin/sandbox fresh; see docs/dev/guides/sandbox.md.
exec "$(dirname "$0")/sandbox" fresh --seed fresh "$@"
