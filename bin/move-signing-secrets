#!/usr/bin/env bash
# Moves the release signing secrets from the repository into the "release" environment, which only v* tags can open.
# One-off, done 2026-11-06: docs/dev/signing.md, "How CI signs". Needed again only if secrets go back to the repository.
# GitHub never gives a secret back, so each value is read again: the updater key and its password from the keyring
# (or files you name), the Apple .p12 from its file and its password from the keyring, the Apple ID and app-specific
# password from you. Then, after you confirm, the repository copies are deleted. No value is printed.
set -euo pipefail

repo="WireCatLabs/wirecat-desktop"
env_name="release"
service="wirecat"
root="$(cd "$(dirname "$0")/.." && pwd)"
self="$root/bin/move-signing-secrets"
p12="$HOME/.config/wirecat-signing/developer-id.p12"
updater_key=""
updater_password=""
delete_only=false
names=(TAURI_SIGNING_PRIVATE_KEY TAURI_SIGNING_PRIVATE_KEY_PASSWORD APPLE_CERTIFICATE APPLE_CERTIFICATE_PASSWORD
  APPLE_ID APPLE_PASSWORD APPLE_TEAM_ID)

usage() {
  cat <<EOF
Usage:
  $self [--p12 <file>] [--updater-key <file>] [--updater-password <file>]
  $self --delete-only

  --p12 <file>               The Developer ID Application .p12 (default: $p12).
                             Its password comes from the keyring (service $service, account apple-p12-password), or
                             you are asked for it.
  --updater-key <file>       The updater private key, if it is not in the keyring (service $service, account
                             updater-key).
  --updater-password <file>  A file holding the updater key's password, if it is not in the keyring (account
                             updater-key-password).
  --delete-only              Skip storing; only delete the repository copies that the environment already holds.

Stores ${names[*]}
in the "$env_name" environment of $repo, then asks before it deletes the repository copies.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --p12) p12="${2:?--p12 needs a file}"; shift 2 ;;
    --updater-key) updater_key="${2:?--updater-key needs a file}"; shift 2 ;;
    --updater-password) updater_password="${2:?--updater-password needs a file}"; shift 2 ;;
    --delete-only) delete_only=true; shift ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

for program in gh jq; do
  command -v "$program" >/dev/null || { echo "$program is missing." >&2; exit 1; }
done
gh auth status >/dev/null 2>&1 || { echo "Log in first: gh auth login" >&2; exit 1; }
if ! gh api "repos/$repo/environments/$env_name" >/dev/null 2>&1; then
  echo "The \"$env_name\" environment of $repo is missing. Run $root/bin/setup-windows-signing first." >&2
  exit 1
fi

# Reads a value from a file the owner named, else the keyring, else a hidden prompt.
read_value() {
  local file="$1" account="$2" prompt="$3" value=""
  if [ -n "$file" ]; then
    [ -r "$file" ] || { echo "Cannot read $file." >&2; return 1; }
    value="$(cat "$file")"
  elif command -v secret-tool >/dev/null && value="$(secret-tool lookup service "$service" account "$account" 2>/dev/null)" &&
    [ -n "$value" ]; then
    :
  else
    read -rsp "$prompt: " value
    echo >&2
  fi
  [ -n "$value" ] || { echo "Empty value for $account." >&2; return 1; }
  printf '%s' "$value"
}

if [ "$delete_only" = false ]; then
  [ -f "$p12" ] || { echo "No .p12 at $p12. Name it with --p12 <file>." >&2; exit 1; }

  key="$(read_value "$updater_key" updater-key "Updater private key")"
  printf '%s' "$key" | gh secret set TAURI_SIGNING_PRIVATE_KEY --repo "$repo" --env "$env_name" >/dev/null
  unset key
  password="$(read_value "$updater_password" updater-key-password "Updater key password")"
  printf '%s' "$password" | gh secret set TAURI_SIGNING_PRIVATE_KEY_PASSWORD --repo "$repo" --env "$env_name" >/dev/null
  unset password
  echo "Stored TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD in the \"$env_name\" environment."

  # setup-apple-signing checks the .p12, asks for the Apple ID and the app-specific password, and stores the five
  # Apple secrets in the same environment.
  P12_PASSWORD="$(read_value "" apple-p12-password "Password of $p12")"
  export P12_PASSWORD
  echo "The Apple app-specific password cannot be read back. If you do not have it, make a new one at"
  echo "https://account.apple.com (Sign-In and Security, App-Specific Passwords) before you answer."
  "$root/bin/setup-apple-signing" "$p12"
  unset P12_PASSWORD
fi

in_env="$(gh secret list --repo "$repo" --env "$env_name" --json name --jq '.[].name')"
in_repo="$(gh secret list --repo "$repo" --json name --jq '.[].name')"
missing=()
to_delete=()
for name in "${names[@]}"; do
  grep -qx "$name" <<<"$in_env" || missing+=("$name")
  if grep -qx "$name" <<<"$in_env" && grep -qx "$name" <<<"$in_repo"; then
    to_delete+=("$name")
  fi
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "The \"$env_name\" environment still lacks: ${missing[*]}. Their repository copies stay." >&2
fi
if [ "${#to_delete[@]}" -eq 0 ]; then
  echo "No repository copy left to delete."
  exit 0
fi

echo
echo "The \"$env_name\" environment now holds these, and the repository still has copies:"
printf '  %s\n' "${to_delete[@]}"
echo "Any branch's workflow can read a repository secret; only a v* tag can read the environment's."
read -rp "Delete the repository copies? Type yes: " answer
if [ "$answer" != yes ]; then
  echo "Kept them. Delete them later with: $self --delete-only"
  exit 0
fi
for name in "${to_delete[@]}"; do
  gh secret delete "$name" --repo "$repo" >/dev/null
  echo "Deleted the repository copy of $name."
done
