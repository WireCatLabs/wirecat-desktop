#!/usr/bin/env bash
# Search rewriting through the app's own Rust, against a real memo from npm (default: the newest), in a throwaway
# home: no keyring (D-Bus cut), no provider key, all HTTP to a closed port. Nothing is synced, so nothing is sent.
#   bin/enrichment-e2e [memo version]
set -euo pipefail
cd "$(dirname "$0")/.."
version=${1:-latest}
[ -f dist/index.html ] || { mkdir -p dist && echo '<!doctype html>' > dist/index.html; }
root=$(mktemp -d "${TMPDIR:-/tmp}/wirecat-enrich-e2e.XXXXXX")
trap 'rm -rf "$root"' EXIT
npm install --prefix "$root/npm" --no-fund --no-audit --silent "@wirecat/cli-memo@$version"
export CARGO_HOME=${CARGO_HOME:-$HOME/.cargo} RUSTUP_HOME=${RUSTUP_HOME:-$HOME/.rustup}
export HOME="$root/home" XDG_CONFIG_HOME="$root/home/.config" XDG_STATE_HOME="$root/home/.local/state"
export XDG_CACHE_HOME="$root/home/.cache" XDG_DATA_HOME="$root/home/.local/share"
export WIRECAT_STATE_DIR="$root/state" MESSAGING_STORE="$root/store.db" DBUS_SESSION_BUS_ADDRESS=disabled:
export NODE_USE_ENV_PROXY=1 HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9
unset OPENAI_API_KEY ANTHROPIC_API_KEY
export PATH="$root/npm/node_modules/.bin:$PATH" WIRECAT_ENRICH_E2E=1
mkdir -p "$HOME"
cargo test --manifest-path src-tauri/Cargo.toml --lib -- --exact enrichment::e2e::against_a_real_memo --ignored --nocapture
