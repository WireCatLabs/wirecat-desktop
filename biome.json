{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!config/wirecat",
      "!src-tauri/target",
      "!src-tauri/gen",
      "!other",
      "!.impeccable",
      "!.worktrees"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox", "Radio"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-dom",
                      "@tauri-apps/*",
                      "zustand",
                      "@/platform/*",
                      "**/platform/**",
                      "../platform/*",
                      "../../platform/*",
                      "@/features/*",
                      "**/features/**",
                      "../features/*",
                      "../../features/*",
                      "@/ui/*",
                      "**/ui/**",
                      "../ui/*",
                      "../../ui/*",
                      "@/app/*",
                      "**/app/**",
                      "../app/*",
                      "../../app/*"
                    ],
                    "message": "domain is plain TypeScript: no React, no Tauri, nothing above it (docs/dev/ARCHITECTURE.md)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-dom",
                      "zustand",
                      "@/features/*",
                      "**/features/**",
                      "../features/*",
                      "../../features/*",
                      "@/ui/*",
                      "**/ui/**",
                      "../ui/*",
                      "../../ui/*",
                      "@/app/*",
                      "**/app/**",
                      "../app/*",
                      "../../app/*"
                    ],
                    "message": "platform talks to Rust and returns validated data; it knows no UI (docs/dev/ARCHITECTURE.md)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tauri-apps/*",
                      "@/platform/*",
                      "**/platform/**",
                      "../platform/*",
                      "../../platform/*",
                      "@/features/*",
                      "**/features/**",
                      "../features/*",
                      "../../features/*",
                      "@/app/*",
                      "**/app/**",
                      "../app/*",
                      "../../app/*",
                      "@/domain/*",
                      "**/domain/**",
                      "../domain/*",
                      "../../domain/*"
                    ],
                    "message": "ui is presentational: props in, events out; features own data (docs/dev/ARCHITECTURE.md)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/*", "@/app/*", "**/app/**", "../app/*", "../../app/*"],
                    "message": "features reach Rust only through @/platform and never import the app shell (docs/dev/ARCHITECTURE.md)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/system/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tools/**", "../tools/*", "@/features/tools/*"],
                    "message": "system is the base feature: tools may read it, it never reads tools"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
