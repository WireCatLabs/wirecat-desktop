{
  "requirements": {
    "nodeLabel": "Node.js 22.16+ or 24+",
    "nodeDownload": "https://nodejs.org/en/download"
  },
  "tools": [
    {
      "id": "tg",
      "name": "Telegram",
      "tagline": "Your Telegram account, for the terminal and AI agents",
      "bin": "tg",
      "package": "@wirecat/tg-cli",
      "summary": "A Telegram client for the terminal and for AI agents, on your own account.",
      "docs": "https://wirecat.dev/en/docs/tg",
      "repo": "https://github.com/WireCatLabs/tg-cli",
      "profiles": {
        "args": ["account", "list", "--json"],
        "shape": "items"
      },
      "doctor": ["{profile}", "doctor", "--json"],
      "runs": {
        "list": ["runs", "list", "{query}", "--limit", "{limit}", "--page", "{page}", "--json"],
        "show": ["runs", "show", "{run}", "--json"]
      },
      "search": {
        "args": [
          "{profile}",
          "search",
          "messages",
          "--offline",
          "--backend",
          "archive",
          "--timeout",
          "60s",
          "--limit",
          "{limit}",
          "--page",
          "{page}",
          "--no-record",
          "--json",
          "--",
          "{query}"
        ],
        "shape": "items",
        "what": "messages",
        "fields": [
          {
            "name": "from",
            "group": "who",
            "example": "from:\"Ana Ruiz\"",
            "top": true,
            "values": "contacts"
          },
          {
            "name": "chat",
            "group": "where",
            "example": "chat:\"Design crit\"",
            "top": true,
            "values": "chats"
          },
          {
            "name": "date",
            "group": "when",
            "example": "date>=7d",
            "top": true,
            "values": null
          },
          {
            "name": "has",
            "group": "what",
            "example": "has:photo",
            "top": true,
            "values": [
              "photo",
              "file",
              "link",
              "voice",
              "video",
              "audio",
              "image",
              "attachment",
              "sticker",
              "contact",
              "location",
              "poll",
              "text"
            ]
          },
          {
            "name": "tag",
            "group": "what",
            "example": "tag:work",
            "top": true,
            "values": "tags"
          },
          {
            "name": "text",
            "group": "what",
            "example": "text:invoice",
            "top": false,
            "values": null
          },
          {
            "name": "transcript",
            "group": "what",
            "example": "transcript:contract",
            "top": false,
            "values": null
          },
          {
            "name": "kind",
            "group": "where",
            "example": "kind:group",
            "top": false,
            "values": ["private", "group", "channel", "bot", "saved", "service"]
          },
          {
            "name": "in",
            "group": "where",
            "example": "in:bots",
            "top": false,
            "values": ["personal", "bots", "all"]
          },
          {
            "name": "email",
            "group": "who",
            "example": "email:\"ana@example.com\"",
            "top": false,
            "values": null
          },
          {
            "name": "phone",
            "group": "who",
            "example": "phone:\"+34600000000\"",
            "top": false,
            "values": null
          },
          {
            "name": "filename",
            "group": "files",
            "example": "filename:report.pdf",
            "top": false,
            "values": null
          },
          {
            "name": "content",
            "group": "files",
            "example": "content:invoice",
            "top": false,
            "values": null
          },
          {
            "name": "url",
            "group": "files",
            "example": "url:\"github.com/wirecat\"",
            "top": false,
            "values": null
          },
          {
            "name": "link",
            "group": "files",
            "example": "link:docs.google.com",
            "top": false,
            "values": null
          },
          {
            "name": "domain",
            "group": "files",
            "example": "domain:github.com",
            "top": false,
            "values": null
          }
        ],
        "values": {
          "chats": {
            "args": ["{profile}", "chats", "list", "--offline", "--limit", "1000", "--no-record", "--json"],
            "key": "id",
            "label": "title",
            "detail": "/provider_metadata/username"
          },
          "contacts": {
            "args": ["{profile}", "contacts", "list", "--offline", "--limit", "1000", "--no-record", "--json"],
            "key": "id",
            "label": "name",
            "detail": "username"
          },
          "tags": {
            "args": ["{profile}", "tags", "list", "--offline", "--no-record", "--json"],
            "key": "tag",
            "label": null,
            "detail": null
          }
        },
        "context": {
          "args": [
            "{profile}",
            "messages",
            "context",
            "{ref}",
            "--before-n",
            "5",
            "--after-n",
            "5",
            "--offline",
            "--no-record",
            "--json"
          ]
        }
      },
      "setup": ["{profile}", "setup"],
      "skill": {
        "status": ["skill", "status", "--json"],
        "install": ["skill", "install", "--for", "{target}", "--json"],
        "show": ["skill", "show", "--json"]
      },
      "mcp": {
        "check": ["{profile}", "mcp", "check", "--json"],
        "add": ["{profile}", "mcp", "add", "{client}", "--json"]
      },
      "mcpServer": {
        "port": 8765,
        "start": ["mcp", "server", "start", "--port", "{port}", "--public-url", "{url}", "--json"],
        "stop": ["mcp", "server", "stop", "--json"],
        "status": ["mcp", "server", "status", "--json"],
        "revoke": ["mcp", "revoke", "--json"],
        "config": ["mcp", "config", "--json"]
      },
      "tasks": {
        "list": [
          "{profile}",
          "tasks",
          "list",
          "state:open",
          "--limit",
          "1000",
          "--json=id,key,claimed_by,claimed_until"
        ],
        "release": ["{profile}", "tasks", "release", "{task}", "--holder", "owner", "--json"]
      },
      "sync": {
        "run": ["{profile}", "messages", "sync", "--all", "--timeout", "120m", "--record", "--json"],
        "last": ["runs", "list", "command:\"messages sync\" status:success", "--limit", "200", "--json"],
        "lastShape": "runs",
        "what": "messages",
        "note": null
      },
      "storeInfo": ["store", "info", "--json"],
      "storeTables": ["store", "tables", "list", "--json"],
      "storeTableSizes": ["store", "tables", "list", "--full", "--json"],
      "storeCheck": ["store", "check", "--json"],
      "storeBackup": ["store", "backup", "{file}", "--json"],
      "storeBackupEncrypted": ["store", "backup", "--encrypt", "{file}", "--json"],
      "storeResetPreview": ["store", "reset", "--dry-run", "--json"],
      "storeReset": ["store", "reset", "--no-backup", "--yes", "--json"],
      "storage": {
        "app": "tg-cli",
        "env": "TG"
      },
      "settings": {
        "show": ["{profile}", "config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": ["{profile}", "config", "unset", "--json"],
        "shape": "rows",
        "perProfile": true,
        "defaults": true,
        "jsonValues": false,
        "keys": null,
        "readOnly": ["default_profile"]
      },
      "permissions": {
        "commands": ["{profile}", "commands", "--json"],
        "groups": [
          {
            "key": "messages",
            "label": "Messages"
          },
          {
            "key": "reactions",
            "label": "Reactions"
          },
          {
            "key": "polls",
            "label": "Polls"
          },
          {
            "key": "topics",
            "label": "Topics"
          },
          {
            "key": "chats",
            "label": "Chats and groups"
          },
          {
            "key": "contacts",
            "label": "Contacts"
          },
          {
            "key": "account",
            "label": "Account"
          },
          {
            "key": "attachments",
            "label": "Files"
          },
          {
            "key": "tasks",
            "label": "Tasks"
          }
        ]
      },
      "signIn": {
        "gives": "Lets your agent read and search your Telegram chats, and send messages when you ask.",
        "asks": "The first time, your phone number and the code Telegram sends, to register your own Telegram app. Then a QR code to scan in Telegram: Settings → Devices → Link Desktop Device.",
        "methods": [
          {
            "id": "qr",
            "label": "QR code",
            "words": ["{profile}", "session", "start", "qr", "--json", "--answer-stdin"]
          },
          {
            "id": "phone",
            "label": "Phone number",
            "words": ["{profile}", "session", "start", "phone", "--json", "--answer-stdin"]
          }
        ]
      }
    },
