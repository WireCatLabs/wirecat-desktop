      "storeResetPreview": ["store", "reset", "--dry-run", "--json"],
      "storeReset": ["store", "reset", "--no-backup", "--yes", "--json"],
      "storage": {
        "app": "max-cli",
        "env": "MAX"
      },
      "settings": {
        "show": ["{profile}", "config", "show", "--json"],
        "set": ["{profile}", "config", "set", "--json"],
        "unset": ["{profile}", "config", "unset", "--json"],
        "shape": "rows",
        "perProfile": true,
        "defaults": true,
        "jsonValues": false,
        "keys": null,
        "readOnly": ["default_profile"]
      },
      "permissions": {
        "commands": ["{profile}", "commands", "--json"],
        "groups": [
          { "key": "messages", "label": "Messages" },
          { "key": "reactions", "label": "Reactions" },
          { "key": "polls", "label": "Polls" },
          { "key": "chats", "label": "Chats and groups" },
          { "key": "contacts", "label": "Contacts" },
          { "key": "account", "label": "Account" },
          { "key": "attachments", "label": "Files" },
          { "key": "tasks", "label": "Tasks" }
        ]
      },
      "signIn": {
        "gives": "Lets your agent read and search your MAX chats, and send messages when you ask.",
        "asks": "A QR code to scan with the MAX app on your phone.",
        "methods": [
          {
            "id": "qr",
            "label": "QR code",
            "words": ["{profile}", "session", "start", "qr", "--json", "--answer-stdin"]
          }
        ]
      }
